TEXT_PROVIDER=openai
# 填写你自己的 OpenAI-compatible 文本接口地址，例如 https://api.openai.com/v1
LLM_BASE_URL=
LLM_MODEL=gpt-5.5
LLM_API_KEY=
LLM_TEMPERATURE=0.8

# Optional: any OpenAI-compatible gateway, for example a local gemini-web2api.
# TEXT_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:8081/v1
# LLM_MODEL=gemini-3.5-flash-thinking
# LLM_API_KEY=sk-local

IMAGE_PROVIDER=openai
# 填写你自己的 OpenAI-compatible Images 接口地址，例如 https://api.openai.com/v1
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-2
IMAGE_API_KEY=
IMAGE_SIZE=9:16

# Optional MiniMax T2A HTTP TTS adapter.
# API key is read from the MiniMax platform interface-key page.
TTS_PROVIDER=edge
MINIMAX_TTS_BASE_URL=https://api.minimaxi.com/v1/t2a_v2
MINIMAX_TTS_API_KEY=your-minimax-api-key
MINIMAX_TTS_GROUP_ID=
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_VOICE_ID=male-qn-qingse

# Optional Doubao/Volcengine TTS adapter.
# Use TTS_PROVIDER=doubao and fill the API key from the Volcengine console.
DOUBAO_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
DOUBAO_TTS_API_KEY=your-doubao-api-key
DOUBAO_TTS_RESOURCE_ID=volc.service_type.10029
DOUBAO_TTS_SPEAKER=zh_male_beijingxiaoye_emo_v2_mars_bigtts
